{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "none",
  "roles": { "realm": [ { "name": "customer" }, { "name": "admin" } ] },
  "clientScopes": [
    { "name": "basic", "protocol": "openid-connect",
      "protocolMappers": [ { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
        "config": { "access.token.claim": "true", "introspection.token.claim": "true" } } ] },
    { "name": "email", "protocol": "openid-connect",
      "protocolMappers": [ { "name": "email", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper",
        "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true" } } ] },
    { "name": "roles", "protocol": "openid-connect",
      "protocolMappers": [ { "name": "realm roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
        "config": { "claim.name": "realm_access.roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true" } } ] },
    { "name": "order:write", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "order:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "stock:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "stock:reserve", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "notification:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } }
  ],
  "clients": [
    { "clientId": "shop-cli", "enabled": true, "publicClient": true,
      "directAccessGrantsEnabled": true, "standardFlowEnabled": false, "fullScopeAllowed": true,
      "defaultClientScopes": ["basic","email","roles","order:write","order:read","stock:read","stock:reserve","notification:read"] }
  ],
  "users": [
    { "id": "11111111-1111-1111-1111-111111111111", "username": "alice", "email": "alice@test.com", "emailVerified": true,
      "enabled": true, "firstName": "Alice", "lastName": "Customer",
      "credentials": [ { "type": "password", "value": "alice-pass", "temporary": false } ],
      "realmRoles": ["customer"] },
    { "id": "22222222-2222-2222-2222-222222222222", "username": "bob", "email": "bob@test.com", "emailVerified": true,
      "enabled": true, "firstName": "Bob", "lastName": "Customer",
      "credentials": [ { "type": "password", "value": "bob-pass", "temporary": false } ],
      "realmRoles": ["customer"] },
    { "id": "33333333-3333-3333-3333-333333333333", "username": "root", "email": "root@test.com", "emailVerified": true,
      "enabled": true, "firstName": "Root", "lastName": "Admin",
      "credentials": [ { "type": "password", "value": "root-pass", "temporary": false } ],
      "realmRoles": ["admin"] }
  ]
}